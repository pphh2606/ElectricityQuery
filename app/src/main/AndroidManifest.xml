<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".app.ElectricityApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.电费查询"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.电费查询"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".jwxt.todaylesson.widget.TodayLessonWidgetProvider"
            android:label="@string/widget_today_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- 覆盖安装后系统不保证补发 APPWIDGET_UPDATE（ColorOS 实测会漏），
                     额外接收「本包被替换」广播，由 Provider 自己补一次刷新 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_lesson_widget_info" />
        </receiver>

        <!-- 集合小组件的列表数据源：由系统（launcher 侧）绑定，因此用 signature 级权限保护 -->
        <service
            android:name=".jwxt.todaylesson.widget.TodayLessonWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- 「今日课表」（新）：数据源改成「我的课表」，与上面那个旧组件并存；
             验证通过后再删除旧的 receiver / service / 布局 / widget_info -->
        <receiver
            android:name=".jwxt.timetable.widget.TimetableWidgetProviderV2"
            android:label="@string/widget_timetable_v2_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timetable_widget_v2_info" />
        </receiver>

        <service
            android:name=".jwxt.timetable.widget.TimetableWidgetServiceV2"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>

</manifest>
