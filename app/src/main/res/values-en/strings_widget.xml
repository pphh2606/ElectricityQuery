<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Row 2 of a lesson: room · teacher (only one is shown when the other is missing) -->
    <string name="widget_lesson_room_teacher">%1$s · %2$s</string>
    <string name="widget_state_no_account">Sign in to view today\'s classes</string>
    <string name="widget_state_no_cache">Open the app to sync</string>
    <!-- %1$s = last update date (MM-dd) -->
    <string name="widget_state_stale">Needs update (%1$s)</string>
    <string name="widget_loading">Loading classes…</string>

    <!--  "Today's classes" widget (jwxt/timetable, data source: My timetable)  -->
    <!--  Room-teacher / state texts share the keys above; only its own are listed here.  -->
    <string name="widget_timetable_v2_name">Today\'s classes</string>
    <string name="widget_timetable_v2_description">View today\'s class schedule on your home screen</string>
    <string name="widget_timetable_v2_title">Today\'s classes</string>
    <!-- Row 3 when the time could not be extracted: %1$s = section range (e.g. 1-2) -->
    <string name="widget_timetable_v2_section_only">Period %1$s</string>
    <!-- Top info row (always shown): %1$d = lesson count, %2$s = cache write time (HH:mm) -->
    <string name="widget_timetable_v2_footer">%1$d classes · updated %2$s</string>
</resources>
